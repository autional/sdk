{
  "name": "@autional/plugin-tenant",
  "version": "0.3.0",
  "description": "Autional Tenant Plugin — Multi-tenant switching components for @autional/core",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --external react --external @autional/core",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch --external react --external @autional/core",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "auth",
    "authentication",
    "tenant",
    "multi-tenant",
    "autional",
    "plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@autional/core": ">=0.1.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": ">=18.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
