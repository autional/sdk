{
  "name": "@autional/next",
  "version": "0.4.0",
  "description": "Autional Next.js SDK — middleware, server session, and provider for Next.js App Router",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.mjs",
      "require": "./dist/middleware.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.mjs",
      "require": "./dist/provider.js"
    }
  },
  "sideEffects": false,
  "bundleDirectives": {
    "dist/provider.mjs": "use client",
    "dist/provider.js": "use client",
    "dist/middleware.mjs": null,
    "dist/middleware.js": null,
    "dist/server.mjs": null,
    "dist/server.js": null
  },
  "bundleForbiddenImports": {
    "dist/middleware.mjs": [
      "react",
      "react-dom",
      "@autional/react",
      "@autional/core"
    ],
    "dist/middleware.js": [
      "react",
      "react-dom",
      "@autional/react",
      "@autional/core"
    ]
  },
  "scripts": {
    "build": "tsup && node ../../scripts/check-bundle-directives.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "node ../../scripts/prepublish-guard.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "keywords": [
    "auth",
    "nextjs",
    "authentication",
    "autional"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@autional/core": ">=0.3.5",
    "@autional/react": ">=0.3.1",
    "next": ">=14.0.0"
  },
  "dependencies": {
    "@autional/core": ">=0.3.5",
    "@autional/react": ">=0.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
