{
  "name": "@autional/onboard",
  "version": "0.1.0",
  "description": "Autional onboarding CLI — scaffold a React, Vue, or Next.js project",
  "bin": {
    "onboard": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --external inquirer",
    "dev": "tsup src/index.ts --format esm --watch --external inquirer",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "prepublishOnly": "node ../scripts/prepublish-guard.mjs"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "autional",
    "onboarding",
    "scaffold",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "inquirer": "^12.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
